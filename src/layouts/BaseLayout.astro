---
// BaseLayout.astro - Main layout wrapper
interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  class?: string;
}

const {
  title,
  description = 'Oklahoma owned & operated IT support. No jargon. No stress. We come to you.',
  ogImage = '/og-default.jpg',
  noIndex = false,
  class: className = ''
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title} | SilverLink</title>
    <meta name="description" content={description} />
    
    <!-- Canonical -->
    <link rel="canonical" href={canonicalURL} />
    
    <!-- Robots -->
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:site_name" content="SilverLink" />
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Widgo Widget -->
    <script is:inline>
      window.widgoConfig = {
        orgId: "org_4a1d9b6fced54418",
        aiUrl: "https://ai.widgo.ai"
      };
    </script>
    <script async src="https://cdn.widgo.ai/widgo.js"></script>
    
    <!-- Fonts - Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    
    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "LocalBusiness",
      "name": "SilverLink LLC",
      "image": new URL(ogImage, Astro.site).toString(),
      "url": Astro.site,
      "telephone": "+1-405-877-2223",
      "email": "mk@silverlinkok.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Edmond, OK",
        "addressLocality": "Edmond",
        "addressRegion": "OK",
        "postalCode": "73013",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 35.6528,
        "longitude": -97.4781
      },
      "openingHoursSpecification": [
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "09:00",
          "closes": "18:00"
        },
        {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": "Saturday",
          "opens": "10:00",
          "closes": "14:00"
        }
      ],
      "priceRange": "$$",
      "currenciesAccepted": "USD",
      "paymentAccepted": "Cash, Credit Card, ACH, Zelle",
      "areaServed": [
        "Edmond, OK",
        "Deer Creek, OK",
        "Oakdale, OK",
        "Northwest Oklahoma City, OK",
        "Oklahoma City Metro"
      ],
      "serviceType": "IT Support, Computer Repair, Managed Services, Cybersecurity"
    })} />
    
    <!-- Critical CSS Inline -->
    <style>
      /* Critical above-the-fold styles */
      :root {
        --font-display: 'Playfair Display', Georgia, serif;
        --font-body: 'DM Sans', system-ui, sans-serif;
        --font-mono: 'JetBrains Mono', Menlo, monospace;
      }
    </style>
  </head>
  <body class={`font-body text-text-primary bg-background-primary ${className}`}>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    
    <Header />
    
    <main id="main-content" role="main">
      <slot />
    </main>
    
    <Footer />
    
    <!-- SVG Icon Sprite -->
    <script is:inline>
      fetch('/icons.svg')
        .then(res => res.text())
        .then(svg => {
          const div = document.createElement('div');
          div.style.display = 'none';
          div.innerHTML = svg;
          document.body.insertBefore(div, document.body.firstChild);
        })
        .catch(() => {});
    </script>
    
    <!-- Global scripts -->
    <script is:inline src="/scripts/global.js"></script>
  </body>
</html>