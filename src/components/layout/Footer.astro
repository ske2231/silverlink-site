---
// Footer.astro - Site footer
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
import Button from '../ui/Button.astro';
---

<footer class={`site-footer bg-background-secondary border-t border-border-primary ${className}`} role="contentinfo">
  <div class="container mx-auto px-4 md:px-6 lg:px-8">
    <div class="footer-grid grid gap-8 md:gap-12 lg:grid-cols-12 py-12 md:py-16">
      <!-- Brand Column -->
      <div class="footer-brand lg:col-span-4">
        <a href="/" class="footer-logo flex items-center gap-3 mb-4" aria-label="SilverLink Home">
          <svg class="w-8 h-8 text-gold-500" viewBox="0 0 32 32" fill="none" aria-hidden="true">
            <rect width="32" height="32" rx="6" fill="currentColor"/>
            <path d="M8 16 L14 22 L24 10" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>
          <span class="font-display text-heading-lg text-text-primary">SilverLink</span>
        </a>
        <p class="font-body text-body text-text-muted mb-6 max-w-xs">
          Oklahoma owned & operated. No jargon. No stress. We come to you.
        </p>
        <div class="footer-social flex gap-4">
          <a href="https://linkedin.com/in/mjanway" class="social-link w-10 h-10 rounded-full bg-background-tertiary text-text-secondary flex items-center justify-center hover:bg-gold-500 hover:text-text-on-gold transition-all duration-fast" aria-label="LinkedIn" target="_blank" rel="noopener noreferrer">
            <svg class="icon icon-md" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect x="2" y="9" width="4" height="12"/><circle cx="4" cy="4" r="2"/></svg></svg>
          </a>
          <a href="https://ko-fi.com/silverlinkllctechsupport" class="social-link w-10 h-10 rounded-full bg-background-tertiary text-text-secondary flex items-center justify-center hover:bg-gold-500 hover:text-text-on-gold transition-all duration-fast" aria-label="Ko-fi" target="_blank" rel="noopener noreferrer">
            <svg class="icon icon-md" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-13h2v6h-2zm0 8h2v2h-2z"/></svg>
          </a>
          <a href="https://github.com/ske2231" class="social-link w-10 h-10 rounded-full bg-background-tertiary text-text-secondary flex items-center justify-center hover:bg-gold-500 hover:text-text-on-gold transition-all duration-fast" aria-label="GitHub" target="_blank" rel="noopener noreferrer">
            <svg class="icon icon-md" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          </a>
        </div>
      </div>

      <!-- Navigation Columns -->
      <nav class="footer-nav lg:col-span-2" aria-label="Services">
        <h4 class="footer-heading font-display text-heading-sm text-text-primary mb-4">Services</h4>
        <ul class="space-y-3">
          <li><a href="#complete-care" class="footer-link font-body text-body text-text-muted hover:text-gold-500 transition-colors duration-fast">Complete Care</a></li>
          <li><a href="#remote-help" class="footer-link font-body text-body text-text-muted hover:text-gold-500 transition-colors duration-fast">Remote Help</a></li>
          <li><a href="#one-time" class="footer-link font-body text-body text-text-muted hover:text-gold-500 transition-colors duration-fast">One-Time Visits</a></li>
          <li><a href="#business" class="footer-link font-body text-body text-text-muted hover:text-gold-500 transition-colors duration-fast">Business IT</a></li>
        </ul>
      </nav>

      <nav class="footer-nav lg:col-span-2" aria-label="Company">
        <h4 class="footer-heading font-display text-heading-sm text-text-primary mb-4">Company</h4>
        <ul class="space-y-3">
          <li><a href="#about" class="footer-link font-body text-body text-text-muted hover:text-gold-500 transition-colors duration-fast">About SilverLink</a></li>
          <li><a href="#coverage" class="footer-link font-body text-body text-text-muted hover:text-gold-500 transition-colors duration-fast">Coverage Map</a></li>
          <li><a href="#pricing" class="footer-link font-body text-body text-text-muted hover:text-gold-500 transition-colors duration-fast">Pricing</a></li>
          <li><a href="#faq" class="footer-link font-body text-body text-text-muted hover:text-gold-500 transition-colors duration-fast">FAQ</a></li>
        </ul>
      </nav>

      <nav class="footer-nav lg:col-span-2" aria-label="Support">
        <h4 class="footer-heading font-display text-heading-sm text-text-primary mb-4">Support</h4>
        <ul class="space-y-3">
          <li><a href="#contact" class="footer-link font-body text-body text-text-muted hover:text-gold-500 transition-colors duration-fast">Contact Us</a></li>
          <li><a href="#schedule" class="footer-link font-body text-body text-text-muted hover:text-gold-500 transition-colors duration-fast">Schedule Visit</a></li>
          <li><a href="https://ko-fi.com/silverlinkllctechsupport/shop" class="footer-link font-body text-body text-text-muted hover:text-gold-500 transition-colors duration-fast" target="_blank" rel="noopener noreferrer">Digital Guides</a></li>
          <li><a href="#resources" class="footer-link font-body text-body text-text-muted hover:text-gold-500 transition-colors duration-fast">Resources</a></li>
        </ul>
      </nav>

      <!-- Contact Column -->
      <div class="footer-contact lg:col-span-2">
        <h4 class="footer-heading font-display text-heading-sm text-text-primary mb-4">Get In Touch</h4>
        <address class="font-body text-body text-text-muted not-italic space-y-3">
          <div class="flex items-start gap-3">
            <svg class="icon icon-md flex-shrink-0 text-gold-500 mt-0.5" aria-hidden="true"><use href="/icons.svg#icon-map-pin" /></svg>
            <span>Edmond, Deer Creek, Oakdale & NW OKC</span>
          </div>
          <div class="flex items-start gap-3">
            <svg class="icon icon-md flex-shrink-0 text-gold-500 mt-0.5" aria-hidden="true"><use href="/icons.svg#icon-phone" /></svg>
            <a href="tel:+14058772223" class="footer-link hover:text-gold-500 transition-colors duration-fast">(405) 877-2223</a>
          </div>
          <div class="flex items-start gap-3">
            <svg class="icon icon-md flex-shrink-0 text-gold-500 mt-0.5" aria-hidden="true"><use href="/icons.svg#icon-mail" /></svg>
            <a href="mailto:mk@silverlinkok.com" class="footer-link hover:text-gold-500 transition-colors duration-fast">mk@silverlinkok.com</a>
          </div>
        </address>
        <div class="footer-hours mt-6 pt-6 border-t border-border-primary">
          <p class="font-body text-caption text-text-muted">Mon–Fri: 9am–6pm • Sat: 10am–2pm</p>
          <p class="font-body text-caption text-text-muted">Emergency remote: 24/7</p>
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom pt-6 pb-8 border-t border-border-primary flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <p class="font-body text-caption text-text-muted">
        &copy; {new Date().getFullYear()} SilverLink LLC. All rights reserved.
      </p>
      <div class="footer-legal flex flex-wrap gap-4 md:gap-6">
        <a href="#privacy" class="font-body text-caption text-text-muted hover:text-gold-500 transition-colors duration-fast">Privacy</a>
        <a href="#terms" class="font-body text-caption text-text-muted hover:text-gold-500 transition-colors duration-fast">Terms</a>
        <a href="#accessibility" class="font-body text-caption text-text-muted hover:text-gold-500 transition-colors duration-fast">Accessibility</a>
      </div>
    </div>
  </div>
</footer>