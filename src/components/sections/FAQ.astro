---
// FAQ.astro - FAQ section for Silverlink 2
import Button from '../ui/Button.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import Accordion from '../ui/Accordion.astro';
---

<section id="faq" class="faq section section-lg" aria-labelledby="faq-title">
  <div class="container mx-auto px-4 md:px-6 lg:px-8">
    <header class="section-header text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <SectionLabel ruled>Frequently Asked</SectionLabel>
      <h2 id="faq-title" class="font-display text-[var(--text-primary)] text-3xl md:text-4xl lg:text-5xl font-bold mb-4 tracking-tight">
        Straight Answers
      </h2>
      <p class="font-body text-[var(--text-secondary)] text-lg md:text-xl max-w-xl mx-auto">
        No fine print. No runaround. If your question isn't here, just ask.
      </p>
    </header>

    <!-- Category Tabs -->
    <div class="faq-tabs-wrapper mb-12 md:mb-16">
      <div class="tabs flex flex-wrap gap-2 md:gap-4 mb-8 border-b border-[var(--border-primary)]" role="tablist">
        <button role="tab" aria-selected="true" aria-controls="general-panel" id="general-tab" data-tab="general" class="tab px-4 py-3 text-sm font-medium text-[var(--text-primary)] border-b-2 border-[var(--accent-primary)] transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--border-focus)]">
          General Questions
        </button>
        <button role="tab" aria-selected="false" aria-controls="pricing-panel" id="pricing-tab" data-tab="pricing" class="tab px-4 py-3 text-sm font-medium text-[var(--text-muted)] border-b-2 border-transparent hover:text-[var(--text-primary)] transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--border-focus)]">
          Pricing &amp; Plans
        </button>
        <button role="tab" aria-selected="false" aria-controls="services-panel" id="services-panel" data-tab="services" class="tab px-4 py-3 text-sm font-medium text-[var(--text-muted)] border-b-2 border-transparent hover:text-[var(--text-primary)] transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--border-focus)]">
          Services &amp; Support
        </button>
        <button role="tab" aria-selected="false" aria-controls="coverage-panel" id="coverage-panel" data-tab="coverage" class="tab px-4 py-3 text-sm font-medium text-[var(--text-muted)] border-b-2 border-transparent hover:text-[var(--text-primary)] transition-colors duration-200 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--border-focus)]">
          Coverage &amp; Remote
        </button>
      </div>

      <div class="tab-panels">
        <div role="tabpanel" id="general-panel" aria-labelledby="general-tab" class="tab-panel mt-8">
          <Accordion items={[
            {
              question: 'What makes SilverLink LLC different from other IT companies?',
              answer: 'Three things: (1) Same technician every time — MK knows your setup, your preferences, and your history. (2) No jargon — we explain things in plain English, not technobabble. (3) We come to you — no hauling towers to a shop, no waiting rooms. On-site or remote, your call.'
            },
            {
              question: 'Are you licensed and insured?',
              answer: 'Yes. SilverLink LLC is a registered Oklahoma business with full general liability and professional liability insurance. MK holds CompTIA A+ and Security+ certifications with 15+ years in enterprise IT infrastructure, cloud, and security.'
            },
            {
              question: 'Do you work with Macs, PCs, and Linux?',
              answer: 'Primarily Windows and Mac. Linux servers by arrangement. If it plugs in and has an OS, we can probably help — just ask.'
            },
            {
              question: 'What are your hours?',
              answer: 'On-site: Mon–Fri 9am–6pm, Sat 10am–2pm. Remote emergency: 24/7 for Essential Care and Business Care clients. Standard remote: Mon–Fri 8am–8pm, weekends 10am–4pm.'
            }
          ]} />
        </div>

        <div role="tabpanel" id="pricing-panel" aria-labelledby="pricing-tab" class="tab-panel mt-8 hidden">
          <Accordion items={[
            {
              question: 'Is there a contract or cancellation fee?',
              answer: 'No contracts. No cancellation fees. Monthly plans are month-to-month. Price is locked for 12 months from signup. Cancel anytime — just let us know before your next billing date.'
            },
            {
              question: 'What\'s included in the monthly visit?',
              answer: 'Essential Care includes up to 2 remote support hours per month plus a monthly on-site visit window. Business Care includes 5 remote support hours per month. Unused time doesn\'t roll over, but extra time is at a discounted hourly rate.'
            },
            {
              question: 'How do travel fees work?',
              answer: 'OKC metro (15-mile radius from downtown): $0 travel fee for all plans. Extended area (15–50 miles): one-time fee per visit ($35–$60 depending on distance). Beyond 50 miles: remote only, or custom quote for on-site.'
            },
            {
              question: 'Can I switch plans later?',
              answer: 'Yes, anytime. Upgrades take effect immediately. Downgrades take effect at your next billing cycle. No penalties, no prorated hassles.'
            },
            {
              question: 'Do you offer senior or veteran discounts?',
              answer: 'Yes. 10% off monthly plans for seniors (65+), veterans, active military, first responders, and educators. Just mention it when you sign up.'
            }
          ]} />
        </div>

        <div role="tabpanel" id="services-panel" aria-labelledby="services-tab" class="tab-panel mt-8 hidden">
          <Accordion items={[
            {
              question: 'What if I need help between monthly visits?',
              answer: 'Essential Care includes 2 remote support hours per month. Business Care includes 5 remote support hours per month. Emergency remote is 24/7 for plan clients. Most issues are resolved remotely in under 30 minutes.'
            },
            {
              question: 'Can you help with my business\'s Microsoft 365 or Google Workspace?',
              answer: 'Yes. Business Care includes full admin: user management, security policies, shared drives, email routing, compliance settings, and license optimization.'
            },
            {
              question: 'Do you sell hardware or software?',
              answer: 'We don\'t resell hardware (no markup, no conflict of interest). We\'ll spec exactly what you need, order it for you, and set it up — you pay retailer price. Software licenses at our partner cost.'
            },
            {
              question: 'Can you recover data from a failed drive?',
              answer: 'Level 1 (logical/software): yes, on-site. Level 2 (hardware failure): we partner with a cleanroom lab — we handle the logistics, you pay lab direct. Level 3 (catastrophic): referral only.'
            },
            {
              question: 'Do you do virus/malware removal?',
              answer: 'Yes. Included in all plans. We remove the threat, harden the system, and teach you how to avoid reinfection. No scare tactics, no upsells.'
            }
          ]} />
        </div>

        <div role="tabpanel" id="coverage-panel" aria-labelledby="coverage-tab" class="tab-panel mt-8 hidden">
          <Accordion items={[
            {
              question: 'I live outside your service area. Can you still help?',
              answer: 'Absolutely. Remote support covers the entire US. 24/7 emergency remote for Essential Care and Business Care clients. Same MK, same quality, zero travel fees. Screen sharing, secure connection, full troubleshooting.'
            },
            {
              question: 'How does remote support work?',
              answer: 'We send a secure link. You click it, approve the connection, and we see your screen (with your permission). You watch everything we do. Session ends when you close the window. No software stays behind.'
            },
            {
              question: 'Is remote support secure?',
              answer: 'End-to-end encrypted. You control access — we can\'t connect without your explicit approval each time. No unattended access unless you specifically set it up for managed devices.'
            }
          ]} />
        </div>
      </div>
    </div>

    <!-- Still have questions? -->
    <div class="faq-cta text-center p-6 md:p-8 bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl max-w-3xl mx-auto">
      <h3 class="font-display text-[var(--text-primary)] text-xl md:text-2xl font-bold mb-3">Still Have Questions?</h3>
      <p class="font-body text-[var(--text-secondary)] text-sm md:text-base mb-6 max-w-xl mx-auto">
        Can't find what you're looking for? Ask MK directly — no bots, no ticket numbers, no runaround.
      </p>
      <Button variant="primary" size="lg" href="#contact" icon="arrow-right" iconPosition="right">
        Request a Consultation
      </Button>
    </div>
  </div>
</section>

<script>
  // Tab functionality
  document.addEventListener('DOMContentLoaded', () => {
    const tablist = document.querySelector('.faq-tabs-wrapper .tabs');
    if (!tablist) return;

    const tabs = tablist.querySelectorAll('[role="tab"]');
    const panels = tablist.parentElement?.querySelectorAll('[role="tabpanel"]');

    function activateTab(tab) {
      const tabId = tab.dataset.tab;

      tabs.forEach(t => {
        const isActive = t.dataset.tab === tabId;
        t.setAttribute('aria-selected', isActive.toString());
        if (isActive) {
          t.classList.add('text-[var(--text-primary)]', 'border-b-2', 'border-[var(--accent-primary)]');
          t.classList.remove('text-[var(--text-muted)]', 'border-transparent');
        } else {
          t.classList.remove('text-[var(--text-primary)]', 'border-b-2', 'border-[var(--accent-primary)]');
          t.classList.add('text-[var(--text-muted)]', 'border-b-2', 'border-transparent');
        }
      });

      panels?.forEach(panel => {
        panel.classList.toggle('hidden', panel.id !== `${tabId}-panel`);
      });
    }

    tabs.forEach(tab => {
      tab.addEventListener('click', () => activateTab(tab));

      tab.addEventListener('keydown', (e) => {
        const index = Array.from(tabs).indexOf(tab);
        let newIndex = index;

        if (e.key === 'ArrowRight') newIndex = (index + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') newIndex = (index - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') newIndex = 0;
        else if (e.key === 'End') newIndex = tabs.length - 1;

        if (newIndex !== index) {
          e.preventDefault();
          tabs[newIndex].click();
          tabs[newIndex].focus();
        }
      });
    });
  });
</script>

<style>
  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
  }

  .tab {
    position: relative;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-muted);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  .tab:hover {
    color: var(--text-primary);
  }

  .tab-panel {
    animation: fadeIn 0.2s ease-out;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 767px) {
    .tabs {
      overflow-x: auto;
      flex-wrap: nowrap;
      padding-bottom: 0.5rem;
      scrollbar-width: none;
    }
    .tabs::-webkit-scrollbar { display: none; }
  }
</style>