---
// Hero.astro - Hero section for Silverlink 2
import Button from '../ui/Button.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import ZipChecker from '../ui/ZipChecker.astro';
---

<section id="hero" class="hero relative overflow-hidden" aria-labelledby="hero-title">
  <!-- Background -->
  <div class="hero-bg absolute inset-0 -z-10">
    <div class="absolute inset-0 bg-gradient-charcoal-blue" />
    <div class="absolute inset-0 opacity-[0.04] bg-[url('/grid-pattern.svg')]" />
    <div class="absolute top-0 left-0 right-0 h-96 bg-gradient-to-b from-[#2563eb]/10 to-transparent" />
    <div class="absolute top-1/4 left-1/4 w-96 h-96 rounded-full bg-[var(--color-blue-500)]/5 blur-3xl" />
    <div class="absolute bottom-1/4 right-1/4 w-72 h-72 rounded-full bg-[var(--color-blue-400)]/5 blur-3xl" />
  </div>

  <div class="container mx-auto px-4 md:px-6 lg:px-8 relative z-10">
    <div class="hero-content max-w-4xl mx-auto text-center py-20 md:py-24 lg:py-28">

      <!-- Tagline -->
      <div class="mb-6 md:mb-8">
        <SectionLabel class="inline-block">Oklahoma Owned &amp; Operated</SectionLabel>
      </div>

      <!-- Main headline -->
      <h1 id="hero-title" class="font-display text-[var(--text-primary)] text-4xl sm:text-5xl md:text-6xl lg:text-7xl leading-[1.1] mb-6 md:mb-8 tracking-tight">
        Reliable IT.
        <br />
        <span class="text-[var(--accent-primary)]">Fewer interruptions.</span>
      </h1>

      <!-- Subheadline -->
      <p class="font-body text-[var(--text-secondary)] text-lg md:text-xl max-w-2xl mx-auto mb-8 md:mb-10 leading-relaxed">
        On-site computer repair, managed IT, and cybersecurity for Edmond, Deer Creek, Oakdale &amp; NW OKC.
        Same MK. Every visit. No jargon.
      </p>

      <!-- Primary CTA group -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-10 md:mb-12">
        <Button variant="primary" size="xl" href="#contact" icon="arrow-right" iconPosition="right">
          Request Consultation
        </Button>
        <Button variant="secondary" size="xl" href="#plans">
          View Plans &amp; Pricing
        </Button>
      </div>

      <!-- ZIP Checker inline -->
      <div class="hero-zip-checker max-w-md mx-auto mb-10 md:mb-12">
        <ZipChecker id="hero-zip" />
      </div>

      <!-- Trust / highlight indicators -->
      <div class="flex flex-wrap items-center justify-center gap-6 md:gap-10 mt-8 md:mt-12 pt-8 md:pt-12 border-t border-[var(--border-primary)]/50">
        <div class="trust-item flex flex-col items-center gap-1.5">
          <span class="font-display text-2xl md:text-3xl font-bold text-[var(--accent-primary)]">15+</span>
          <span class="font-body text-sm text-[var(--text-muted)]">Years Experience</span>
        </div>
        <div class="trust-divider w-px h-10 bg-[var(--border-primary)]/50 hidden md:block" aria-hidden="true" />
        <div class="trust-item flex flex-col items-center gap-1.5">
          <span class="font-display text-2xl md:text-3xl font-bold text-[var(--accent-primary)]">500+</span>
          <span class="font-body text-sm text-[var(--text-muted)]">Satisfied Clients</span>
        </div>
        <div class="trust-divider w-px h-10 bg-[var(--border-primary)]/50 hidden md:block" aria-hidden="true" />
        <div class="trust-item flex flex-col items-center gap-1.5">
          <span class="font-display text-2xl md:text-3xl font-bold text-[var(--accent-primary)]">24/7</span>
          <span class="font-body text-sm text-[var(--text-muted)]">Remote Support</span>
        </div>
        <div class="trust-divider w-px h-10 bg-[var(--border-primary)]/50 hidden md:block" aria-hidden="true" />
        <div class="trust-item flex flex-col items-center gap-1.5">
          <span class="font-display text-2xl md:text-3xl font-bold text-[var(--accent-primary)]">$0</span>
          <span class="font-body text-sm text-[var(--text-muted)]">Local Travel Fee</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="hero-scroll absolute bottom-6 md:bottom-8 left-1/2 -translate-x-1/2 animate-bounce" aria-hidden="true">
    <svg class="w-5 h-5 md:w-6 md:h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
    </svg>
  </div>
</section>

<style>
  .hero-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(ellipse 70% 50% at 50% -10%, rgba(37, 99, 235, 0.12), transparent),
      radial-gradient(ellipse 80% 40% at 70% 100%, rgba(59, 130, 246, 0.08), transparent);
    pointer-events: none;
  }

  .hero-scroll {
    animation: bounce 2.2s infinite;
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% { transform: translateX(-50%) translateY(0); }
    40% { transform: translateX(-50%) translateY(-8px); }
    60% { transform: translateX(-50%) translateY(-4px); }
  }

  @media (max-width: 767px) {
    .hero-content { padding-top: 3rem; }
    .hero-trust { gap: 4px !important; }
    .trust-item { padding: 0 1.25rem; }
  }
</style>