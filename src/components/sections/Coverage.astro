---
import Button from '../ui/Button.astro';
import SectionLabel from '../ui/SectionLabel.astro';
import ZipChecker from '../ui/ZipChecker.astro';
import Map from '../ui/Map.astro';

// Coverage.astro - Coverage area section with interactive map
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;

const neighborhoods = [
  // Included (OKC Metro + 15 miles)
  { name: 'Downtown OKC', zip: '73102', type: 'included' },
  { name: 'North OKC / Nichols Hills', zip: '73116', type: 'included' },
  { name: 'South OKC', zip: '73109', type: 'included' },
  { name: 'Edmond', zip: '73013', type: 'included' },
  { name: 'Moore', zip: '73160', type: 'included' },
  { name: 'Norman', zip: '73072', type: 'included' },
  { name: 'Yukon', zip: '73099', type: 'included' },
  { name: 'Mustang', zip: '73064', type: 'included' },
  { name: 'Midwest City', zip: '73110', type: 'included' },
  { name: 'Del City', zip: '73115', type: 'included' },
  { name: 'The Village', zip: '73120', type: 'included' },
  { name: 'Bethany', zip: '73008', type: 'included' },
  { name: 'Warr Acres', zip: '73122', type: 'included' },
  { name: 'Oakdale', zip: '73025', type: 'included' },
  { name: 'Deer Creek', zip: '73034', type: 'included' },
  
  // Travel fee areas
  { name: 'Shawnee', zip: '74801', type: 'travel', fee: 50 },
  { name: 'Stillwater', zip: '74074', type: 'travel', fee: 60 },
  { name: 'Guthrie', zip: '73044', type: 'travel', fee: 40 },
  { name: 'El Reno', zip: '73036', type: 'travel', fee: 45 },
  { name: 'Purcell', zip: '73080', type: 'travel', fee: 45 },
  { name: 'Pauls Valley', zip: '73075', type: 'travel', fee: 50 },
];

const includedNeighborhoods = neighborhoods.filter(n => n.type === 'included');
const travelNeighborhoods = neighborhoods.filter(n => n.type === 'travel');
---

<section id="coverage" class={`coverage section section-lg ${className}`} aria-labelledby="coverage-title">
  <div class="container mx-auto px-4 md:px-6 lg:px-8">
    <header class="section-header text-center max-w-3xl mx-auto mb-10 md:mb-14">
      <SectionLabel ruled>Service Area</SectionLabel>
      <h2 id="coverage-title" class="font-display text-display-lg md:text-display-xl text-text-primary mb-4">
        We Cover the OKC Metro
      </h2>
      <p class="font-body text-body-lg text-text-secondary">
        Monthly plans include travel within 15 miles of downtown. Beyond that, a simple travel fee applies.
        Remote help covers everywhere.
      </p>
    </header>

    <!-- ZIP Checker Prominent -->
    <div class="zip-checker-section max-w-xl mx-auto mb-12 md:mb-16">
      <ZipChecker id="coverage-zip" />
    </div>

    <!-- Interactive Map -->
    <div class="map-section mb-12 md:mb-16">
      <Map id="okc-map" height="550px" />
    </div>

    <!-- Neighborhood Lists -->
    <div class="neighborhood-lists grid gap-8 md:grid-cols-2">
      <!-- Included Areas -->
      <div class="included-areas bg-background-card border border-border-primary rounded-card p-6 md:p-8">
        <header class="flex items-center gap-3 mb-6">
          <span class="w-3 h-3 rounded-full bg-gold-500" aria-hidden="true"></span>
          <h3 class="font-display text-heading-lg text-text-primary">Included in Complete Care</h3>
        </header>
        <p class="font-body text-body-sm text-text-muted mb-6">No travel fee. Monthly visit included.</p>
        
        <div class="neighborhood-grid grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
          {includedNeighborhoods.map(n => (
            <div class="neighborhood-item flex items-center gap-3 p-3 rounded-md hover:bg-background-tertiary transition-colors duration-fast" data-zip={n.zip}>
              <span class="neighborhood-pin w-2 h-2 rounded-full bg-gold-500 flex-shrink-0" aria-hidden="true"></span>
              <span class="font-body text-body text-text-primary">{n.name}</span>
              <span class="font-mono text-caption text-text-muted ml-auto">{n.zip}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Travel Fee Areas -->
      <div class="travel-areas bg-background-card border border-border-primary rounded-card p-6 md:p-8">
        <header class="flex items-center gap-3 mb-6">
          <span class="w-3 h-3 rounded-full border-2 border-gold-500 bg-transparent" aria-hidden="true"></span>
          <h3 class="font-display text-heading-lg text-text-primary">Travel Fee Applies</h3>
        </header>
        <p class="font-body text-body-sm text-text-muted mb-6">One-time fee per visit. Remote always free.</p>
        
        <div class="neighborhood-grid grid gap-2 sm:grid-cols-2">
          {travelNeighborhoods.map(n => (
            <div class="neighborhood-item flex items-center gap-3 p-3 rounded-md hover:bg-background-tertiary transition-colors duration-fast" data-zip={n.zip}>
              <span class="neighborhood-pin w-2 h-2 rounded-full border-2 border-gold-500 bg-transparent flex-shrink-0" aria-hidden="true"></span>
              <span class="font-body text-body text-text-primary">{n.name}</span>
              <span class="font-body text-body font-medium text-gold-500 ml-auto">${n.fee}</span>
              <span class="font-mono text-caption text-text-muted ml-2">({n.zip})</span>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Remote Coverage Note -->
    <div class="remote-coverage mt-10 md:mt-14 text-center">
      <div class="inline-flex items-center gap-3 p-4 md:p-6 bg-background-card border border-border-primary rounded-card max-w-3xl">
        <div class="flex-shrink-0 w-12 h-12 rounded-xl bg-gold-100/50 dark:bg-gold-900/20 flex items-center justify-center text-gold-600 dark:text-gold-400">
          <svg class="icon icon-xl" aria-hidden="true"><use href="/icons.svg#icon-message-square" /></svg>
        </div>
        <div class="text-left">
          <h4 class="font-display text-heading-md text-text-primary mb-1">Not in our area?</h4>
          <p class="font-body text-body text-text-secondary">
            Remote support covers you 100% — same MK, same quality, zero travel fees.
            Available nationwide, 24/7 for emergencies.
          </p>
          <Button variant="ghost" size="sm" href="#contact" class="mt-3">
            Try Remote Help
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Link neighborhood items to map
  document.addEventListener('DOMContentLoaded', () => {
    const items = document.querySelectorAll('.neighborhood-item[data-zip]');
    const zipInput = document.getElementById('coverage-zip-input');
    
    items.forEach(item => {
      item.style.cursor = 'pointer';
      item.addEventListener('click', () => {
        const zip = item.dataset.zip;
        if (zip && zipInput) {
          zipInput.value = zip;
          // Trigger the check
          const event = new Event('input', { bubbles: true });
          zipInput.dispatchEvent(event);
          // Submit the form
          const form = zipInput.closest('form');
          if (form) {
            const submitEvent = new Event('submit', { bubbles: true, cancelable: true });
            form.dispatchEvent(submitEvent);
          }
          // Scroll to result
          const result = document.getElementById('coverage-zip-result');
          result?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });
  });
</script>

<style>
  .neighborhood-item {
    border: 1px solid transparent;
  }
  
  .neighborhood-item:hover {
    border-color: var(--border-primary);
  }
  
  .neighborhood-pin {
    flex-shrink: 0;
  }
</style>