---
// Pricing.astro - Pricing section for Silverlink 2
import Button from '../ui/Button.astro';
import SectionLabel from '../ui/SectionLabel.astro';

const plans = [
  {
    name: 'Essential Care',
    price: 199,
    period: '/month',
    popular: true,
    description: 'Monthly managed IT for homes and small setups.',
    deviceCount: 3,
    remoteHours: '2 hours',
    onSite: 'Monthly visit window',
    features: [
      'Up to 3 devices covered',
      '2 remote support hours per month',
      'Monthly on-site visit window',
      'Proactive monitoring & alerts',
      'Automated patch management',
      'Antivirus/EDR management',
      'Backup health checks',
      'Quarterly security review',
      'Priority scheduling & response',
      'No travel fees (OKC metro)'
    ],
    ctaText: 'Start Essential Care',
    ctaHref: '#contact',
    ctaVariant: 'primary'
  },
  {
    name: 'Business Care',
    price: 449,
    period: '/month',
    popular: false,
    description: 'Fractional IT for small businesses.',
    deviceCount: 10,
    remoteHours: '5 hours',
    onSite: 'As-needed',
    features: [
      'Up to 10 devices covered',
      '5 remote support hours per month',
      'Microsoft 365 / Google Workspace admin',
      'Vendor & license management',
      'Compliance documentation (HIPAA, CMMC)',
      'Network monitoring & firewall mgmt',
      'Security awareness training',
      'Quarterly strategy review (1 hr)',
      'Business continuity planning',
      'Employee onboarding/offboarding IT'
    ],
    ctaText: 'Discuss Business Plan',
    ctaHref: '#contact',
    ctaVariant: 'secondary'
  }
];

const oneTimeServices = [
  { name: 'Quick Fix', price: 79, description: 'One remote troubleshooting session, up to 45 minutes', includes: 'Screen-share session · No travel fee', icon: 'wrench' },
  { name: 'Setup & Optimize', price: 149, description: 'One computer setup or optimization session, up to 90 minutes', includes: 'On-site · Data transfer · Security baseline', icon: 'laptop' },
  { name: 'Network Tune-Up', price: 129, description: 'Router placement, channel optimization, whole-home coverage', includes: 'On-site · Mesh setup · Coverage check', icon: 'wifi' },
  { name: 'Security Hardening', price: 249, description: 'Lock down devices, accounts, and network against threats', includes: 'On-site · Scam prevention · Password audit', icon: 'shield-check' },
  { name: 'Smart Home Setup', price: 149, description: 'Alexa, Ring, smart lights, cameras — configured and secured', includes: 'On-site · Device config · Security review', icon: 'smart-home' },
  { name: 'Data Backup Setup', price: 129, description: 'Cloud or local backup setup. Recovery assistance if files are lost.', includes: 'Remote or on-site · Cloud or local', icon: 'database' }
];
---

<section id="plans" class="pricing section section-lg" aria-labelledby="pricing-title">
  <div class="container mx-auto px-4 md:px-6 lg:px-8">
    <!-- Monthly Plans Header -->
    <header class="section-header text-center max-w-3xl mx-auto mb-12 md:mb-16">
      <SectionLabel ruled>Monthly Plans</SectionLabel>
      <h2 id="pricing-title" class="font-display text-[var(--text-primary)] text-3xl md:text-4xl lg:text-5xl font-bold mb-4 tracking-tight">
        Ongoing Support That Fits
      </h2>
      <p class="font-body text-[var(--text-secondary)] text-lg md:text-xl max-w-xl mx-auto">
        Cancel anytime. No contracts. Price locked for 12 months.
      </p>
    </header>

    <!-- Plan comparison note -->
    <div class="plans-note text-center mb-12 md:mb-16">
      <p class="font-body text-sm text-[var(--text-muted)] bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl py-4 px-6 inline-block">
        <svg class="icon icon-sm mr-2 text-[var(--accent-primary)]" aria-hidden="true"><use href="/icons.svg#icon-check" /></svg>
        Hardware, software licenses, and additional support time are not included.
        &nbsp;&nbsp;•&nbsp;&nbsp;
        <svg class="icon icon-sm mr-2 text-[var(--accent-primary)]" aria-hidden="true"><use href="/icons.svg#icon-info" /></svg>
        Travel within OKC metro (15-mile radius) included. Extended areas: travel fee applies.
      </p>
    </div>

    <!-- Plans grid -->
    <div class="plans-grid grid gap-5 md:gap-6 lg:grid-cols-2">
      {plans.map(plan => (
        <article class={`plan-card card overflow-hidden ${plan.popular ? 'ring-2 ring-[var(--accent-primary)] shadow-lg' : ''}`}>
          {plan.popular && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 z-10">
              <span class="bg-[var(--accent-primary)] text-[var(--text-on-blue)] text-xs font-semibold px-3 py-1 rounded-full uppercase tracking-wider">Most Popular</span>
            </div>
          )}

          <div class="p-6 md:p-7 flex flex-col h-full">
            <!-- Plan header -->
            <div class="mb-5">
              <div class="plan-name text-[var(--text-primary)] text-lg md:text-xl font-bold mb-1">{plan.name}</div>
              <div class="plan-desc text-[var(--text-muted)] text-sm mb-4">{plan.description}</div>
            </div>

            <!-- Price -->
            <div class="plan-price mb-5">
              <span class="font-display text-3xl md:text-4xl font-bold text-[var(--text-primary)]">${plan.price}</span>
              <span class="font-body text-[var(--text-muted)] text-base ml-1">{plan.period}</span>
              <span class="font-body text-xs text-[var(--text-muted)] ml-2">per month, billed monthly</span>
            </div>

            <!-- What's included -->
            <div class="plan-includes mb-5">
              <h4 class="font-body text-sm font-semibold text-[var(--text-primary)] mb-3 uppercase tracking-wider text-xs">What\'s Included</h4>
              <ul class="space-y-2.5">
                {plan.features.map(feature => (
                  <li class="flex items-start gap-3 text-sm text-[var(--text-secondary)]">
                    <svg class="icon icon-xs flex-shrink-0 mt-0.5 text-[var(--accent-primary)]" aria-hidden="true"><use href="/icons.svg#icon-check" /></svg>
                    <span>{feature}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Scope footnote -->
            <div class="plan-scope text-xs text-[var(--text-muted)] border-t border-[var(--border-primary)] pt-3 mt-1">
              Hardware, software licenses, and additional support time are not included.
            </div>

            <!-- CTA -->
            <div class="mt-auto pt-4">
              <Button
                variant={plan.popular ? 'primary' : 'secondary'}
                size="xl"
                fullWidth
                href={plan.ctaHref}
              >
                {plan.ctaText}
              </Button>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- One-Time Services -->
    <div class="onetime-section mt-16 md:mt-20">
      <header class="section-header text-center max-w-3xl mx-auto mb-10 md:mb-14">
        <SectionLabel ruled>One-Time Services</SectionLabel>
        <h3 class="font-display text-[var(--text-primary)] text-xl md:text-2xl font-bold mb-3 tracking-tight">Pay Per Visit — No Commitment</h3>
        <p class="font-body text-[var(--text-secondary)] text-base md:text-lg max-w-xl mx-auto">
          Need a single fix, setup, or checkup? Book exactly what you need.
        </p>
      </header>

      <div class="onetime-grid grid gap-4 md:gap-5 lg:grid-cols-2 xl:grid-cols-3">
        {oneTimeServices.map(service => (
          <article class={`onetime-card card p-5 md:p-6 hover:border-[var(--accent-primary)]/50 hover:shadow-md transition-all duration-200`}>
            <div class="onetime-header mb-3">
              <div class="flex items-center gap-3 mb-2">
                <svg class="icon icon-lg text-[var(--accent-primary)]" aria-hidden="true"><use href={`/icons.svg#icon-${service.icon}`} /></svg>
                <h4 class="font-display text-[var(--text-primary)] text-base md:text-lg font-bold">{service.name}</h4>
              </div>
              <p class="font-body text-xs md:text-sm text-[var(--text-muted)] leading-relaxed">{service.description}</p>
            </div>

            <div class="onetime-price mb-3">
              <span class="font-display text-2xl md:text-3xl font-bold text-[var(--accent-primary)]">${service.price}</span>
              <span class="font-body text-xs text-[var(--text-muted)] ml-1.5">flat rate</span>
            </div>

            <p class="onetime-includes font-body text-xs text-[var(--text-muted)] flex items-center gap-1.5 mb-4">
              <svg class="icon icon-xs shrink-0 text-[var(--accent-primary)]" aria-hidden="true"><use href="/icons.svg#icon-check" /></svg>
              {service.includes}
            </p>

            <Button variant="secondary" size="lg" fullWidth href="#contact" class="mt-auto">
              Book This
            </Button>
          </article>
        ))}
      </div>

      <!-- Scope clarity -->
      <div class="scope-clarity mt-12 md:mt-16 p-6 md:p-8 bg-[var(--bg-card)] border border-[var(--border-primary)] rounded-xl">
        <h4 class="font-display text-[var(--text-primary)] text-lg md:text-xl font-bold mb-4 text-center md:text-left">What Every Visit Includes</h4>
        <div class="scope-grid grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
          {[
            'Diagnosis &amp; explanation in plain English',
            'Written summary emailed after visit',
            'No upsells — we only fix what\'s broken',
            '30-day warranty on work performed'
          ].map(item => (
            <div class="flex items-start gap-3 text-sm text-[var(--text-secondary)]">
              <svg class="icon icon-xs flex-shrink-0 mt-0.5 text-[var(--accent-primary)]" aria-hidden="true"><use href="/icons.svg#icon-check" /></svg>
              <span>{item}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .plan-card {
    position: relative;
    padding: 1.5rem;
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .plan-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-xl);
  }

  .onetime-card {
    transition: box-shadow 0.2s ease, border-color 0.2s ease;
  }

  @media (max-width: 767px) {
    .plan-card { padding: 1.25rem; }
    .onetime-grid { grid-template-columns: 1fr; }
    .scope-grid { grid-template-columns: 1fr; }
    .plans-grid { grid-template-columns: 1fr; }
  }
</style>