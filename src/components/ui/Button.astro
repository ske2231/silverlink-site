---
// Button.astro - Reusable button component
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  fullWidth?: boolean;
  icon?: string; // icon name from sprite
  iconPosition?: 'left' | 'right';
  class?: string;
  'aria-label'?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  fullWidth = false,
  icon,
  iconPosition = 'right',
  class: className = '',
  'aria-label': ariaLabel,
  ...attrs
} = Astro.props;

const isLink = !!href;

const baseClasses = `
  inline-flex items-center justify-center gap-2
  font-body font-semibold
  rounded-btn
  transition-all duration-fast ease-smooth
  focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2
  disabled:opacity-50 disabled:cursor-not-allowed
  ${fullWidth ? 'w-full' : ''}
`;

const variantClasses = {
  primary: `
    bg-gold-500 text-navy-900
    hover:bg-gold-400 hover:shadow-md
    active:bg-gold-600 active:shadow-sm
    focus-visible:ring-gold-300 focus-visible:ring-offset-navy-900
  `,
  secondary: `
    bg-transparent border-2 border-gold-500 text-gold-500
    hover:bg-gold-500 hover:text-navy-900
    active:bg-gold-600 active:text-navy-900
    focus-visible:ring-gold-300 focus-visible:ring-offset-navy-900
  `,
  ghost: `
    bg-transparent text-gold-500
    hover:text-gold-400 hover:bg-gold-100/50 dark:hover:bg-gold-900/20
    px-4 py-2.5
    focus-visible:ring-gold-300 focus-visible:ring-offset-navy-900
  `
};

const sizeClasses = {
  sm: 'px-4 py-2 text-body-sm gap-1.5',
  md: 'px-6 py-3.5 text-body gap-2',
  lg: 'px-8 py-4.5 text-body-lg gap-2.5',
  xl: 'px-10 py-5.5 text-heading-md gap-3'
};

const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
---

{isLink ? (
  <a
    {...attrs}
    class={classes}
    href={href}
    aria-disabled={disabled}
    aria-label={ariaLabel}
    role={attrs.role}
  >
    {icon && iconPosition === 'left' && <svg class="icon icon-md" aria-hidden="true"><use href={`/icons.svg#icon-${icon}`} /></svg>}
    <slot />
    {icon && iconPosition === 'right' && <svg class="icon icon-md" aria-hidden="true"><use href={`/icons.svg#icon-${icon}`} /></svg>}
  </a>
) : (
  <button
    {...attrs}
    class={classes}
    type={type}
    disabled={disabled}
    aria-disabled={disabled}
    aria-label={ariaLabel}
  >
    {icon && iconPosition === 'left' && <svg class="icon icon-md" aria-hidden="true"><use href={`/icons.svg#icon-${icon}`} /></svg>}
    <slot />
    {icon && iconPosition === 'right' && <svg class="icon icon-md" aria-hidden="true"><use href={`/icons.svg#icon-${icon}`} /></svg>}
  </button>
)}

<style>
  /* Icon animation on hover for primary/secondary */
  .btn-primary:not(:disabled):hover .icon:last-child,
  .btn-secondary:not(:disabled):hover .icon:last-child {
    transform: translateX(2px);
    transition: transform 0.15s ease;
  }
</style>