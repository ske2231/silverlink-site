---
// Button.astro - Reusable button component
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  href?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  fullWidth?: boolean;
  icon?: string; // icon name from sprite
  iconPosition?: 'left' | 'right';
  class?: string;
  'aria-label'?: string;
}

const {
  variant = 'primary',
  size = 'md',
  href,
  type = 'button',
  disabled = false,
  fullWidth = false,
  icon,
  iconPosition = 'right',
  class: className = '',
  'aria-label': ariaLabel,
  ...attrs
} = Astro.props;

const isLink = !!href;

const baseClasses = `
  inline-flex items-center justify-center gap-2
  font-body font-semibold
  rounded-lg
  transition-all duration-200 ease-out
  focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[var(--border-focus)]
  disabled:opacity-50 disabled:cursor-not-allowed
  ${fullWidth ? 'w-full' : ''}
`;

const variantClasses = {
  primary: `
    bg-[var(--accent-primary)] text-[var(--text-on-blue)]
    hover:bg-[var(--accent-hover)] hover:shadow-md
    active:bg-[var(--color-blue-600)]
    focus-visible:ring-[var(--accent-primary)]
  `,
  secondary: `
    bg-transparent border-2 border-[var(--accent-primary)] text-[var(--accent-primary)]
    hover:bg-[var(--accent-primary)] hover:text-[var(--text-on-blue)]
    active:bg-[var(--color-blue-600)]
    focus-visible:ring-[var(--accent-primary)]
  `,
  ghost: `
    bg-transparent text-[var(--accent-primary)]
    hover:bg-[var(--accent-subtle)] hover:text-[var(--accent-primary)]
    px-4 py-2.5
    focus-visible:ring-[var(--accent-primary)]
  `
};

const sizeClasses = {
  sm: 'px-3 py-1.5 text-xs gap-1.5',
  md: 'px-5 py-2.5 text-sm gap-2',
  lg: 'px-7 py-3.5 text-base gap-2.5',
  xl: 'px-9 py-4.5 text-lg gap-3'
};

const classes = `${baseClasses} ${variantClasses[variant]} ${sizeClasses[size]} ${className}`;
---

{isLink ? (
  <a
    {...attrs}
    class={classes}
    href={href}
    aria-disabled={disabled}
    aria-label={ariaLabel}
    role={attrs.role}
  >
    {icon && iconPosition === 'left' && <svg class="icon icon-md" aria-hidden="true"><use href={`/icons.svg#icon-${icon}`} /></svg>}
    <slot />
    {icon && iconPosition === 'right' && <svg class="icon icon-md" aria-hidden="true"><use href={`/icons.svg#icon-${icon}`} /></svg>}
  </a>
) : (
  <button
    {...attrs}
    class={classes}
    type={type}
    disabled={disabled}
    aria-disabled={disabled}
    aria-label={ariaLabel}
  >
    {icon && iconPosition === 'left' && <svg class="icon icon-md" aria-hidden="true"><use href={`/icons.svg#icon-${icon}`} /></svg>}
    <slot />
    {icon && iconPosition === 'right' && <svg class="icon icon-md" aria-hidden="true"><use href={`/icons.svg#icon-${icon}`} /></svg>}
  </button>
)}

<style>
  /* Icon animation on hover for primary/secondary */
  .btn-primary:not(:disabled):hover .icon:last-child,
  .btn-secondary:not(:disabled):hover .icon:last-child {
    transform: translateX(3px);
    transition: transform 0.2s ease;
  }
</style>