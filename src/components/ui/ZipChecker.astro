---
// ZipChecker.astro - ZIP code coverage checker
interface Props {
  id?: string;
  class?: string;
  onResult?: string; // JavaScript function name to call with result
}

const { id = 'zip-checker', class: className = '', onResult } = Astro.props;
---

<div id={id} class={`zip-checker max-w-md mx-auto text-center ${className}`}>
  <label for={`${id}-input`} class="zip-label block font-body font-medium text-body-sm text-text-secondary mb-3">
    Is your address covered?
  </label>
  <form class="zip-form" data-zip-checker>
    <div class="zip-input-group flex gap-3">
      <input
        type="text"
        id={`${id}-input`}
        name="zip"
        class="zip-input flex-1 font-mono text-body-lg text-center tracking-widest bg-background-input border border-border-primary rounded-input focus:ring-2 focus:ring-border-focus"
        placeholder="Enter ZIP code"
        maxlength="5"
        pattern="[0-9]{5}"
        required
        autocomplete="postal-code"
        aria-describedby={`${id}-result`}
      />
      <Button type="submit" variant="primary" size="md" class="shrink-0">
        Check
      </Button>
    </div>
  </form>
  <div
    id={`${id}-result`}
    class="zip-result mt-4 min-h-[3rem] font-body text-body transition-all duration-fast"
    aria-live="polite"
    aria-atomic="true"
  >
    <span class="zip-result-placeholder text-text-muted">Enter a 5-digit Oklahoma ZIP code to check coverage</span>
  </div>
</div>

