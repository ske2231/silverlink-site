  function checkZip(zip: string) {
    const resultEl = document.getElementById(`${id}-result`);
    const inputEl = document.getElementById(`${id}-input`) as HTMLInputElement;
    
    if (!zip || zip.length !== 5) {
      resultEl.innerHTML = '<span class="zip-result-error text-error-500">Please enter a valid 5-digit ZIP code</span>';
      resultEl.className = 'zip-result mt-4 min-h-[3rem] font-body text-body error';
      return;
    }

    const data = COVERAGE_DATA[zip];
    
    if (!data) {
      // Check if it's an Oklahoma ZIP (730xx, 731xx, 74xxx)
      const isOkZip = /^7[3-4]\d{3}$/.test(zip);
      if (isOkZip) {
        resultEl.innerHTML = '<span class="zip-result-remote text-text-secondary">📱 Your ZIP is outside our in-person range. Remote support covers you fully — same MK, same quality.</span>';
        resultEl.className = 'zip-result mt-4 min-h-[3rem] font-body text-body remote-only';
      } else {
        resultEl.innerHTML = '<span class="zip-result-error text-error-500">We currently serve Oklahoma ZIP codes only. Remote help available nationwide.</span>';
        resultEl.className = 'zip-result mt-4 min-h-[3rem] font-body text-body error';
      }
      return;
    }

    let className = 'zip-result mt-4 min-h-[3rem] font-body text-body ';
    let html = '';

    switch (data.type) {
      case 'included':
        className += 'included text-success-500';
        html = `<span class="zip-result-included">${data.message}</span>`;
        break;
      case 'travel':
        className += 'travel-fee text-warning-500';
        html = `<span class="zip-result-travel">${data.message}</span>`;
        break;
      case 'remote':
        className += 'remote-only text-text-secondary';
        html = `<span class="zip-result-remote">${data.message}</span>`;
        break;
    }

    resultEl.innerHTML = html;
    resultEl.className = className;

    // Call optional callback
    if (onResult && typeof (window as any)[onResult] === 'function') {
      (window as any)[onResult](data);
    }
  }

  // Form submission
  const form = document.querySelector(`#${id} .zip-form`);
  const input = document.getElementById(`${id}-input`) as HTMLInputElement;

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const zip = input.value.trim();
    checkZip(zip);
  });

  // Real-time validation
  input?.addEventListener('input', (e) => {
    const value = (e.target as HTMLInputElement).value;
    // Only allow digits
    (e.target as HTMLInputElement).value = value.replace(/\D/g, '');
  });

  // Expose checkZip globally
  (window as any).checkZip = checkZip;
</script>