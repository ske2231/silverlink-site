---
// Input.astro - Form input component
interface Props {
  id: string;
  name: string;
  type?: 'text' | 'email' | 'tel' | 'password' | 'number' | 'url' | 'select';
  label: string;
  placeholder?: string;
  required?: boolean;
  error?: string;
  hint?: string;
  value?: string;
  class?: string;
  autocomplete?: string;
  pattern?: string;
  maxlength?: number;
  min?: string;
  max?: string;
  step?: string;
  options?: Array<{ value: string; label: string }>;
}

const {
  id,
  name,
  type = 'text',
  label,
  placeholder,
  required = false,
  error,
  hint,
  value,
  class: className = '',
  autocomplete,
  pattern,
  maxlength,
  min,
  max,
  step,
  options = []
} = Astro.props;

const hasError = !!error;
---

<div class={`form-field space-y-1.5 ${className}`}>
  <label for={id} class="block font-body font-medium text-[var(--text-primary)] text-sm mb-1.5">
    {label} {required && <span class="text-[var(--color-error-500)]" aria-hidden="true">*</span>}
  </label>
  {type === 'select' ? (
    <select
      id={id}
      name={name}
      class={`
        w-full font-body text-sm bg-[var(--bg-input)] border rounded-lg px-4 py-3
        text-[var(--text-primary)] placeholder:text-[var(--text-muted)]
        transition-all duration-200 ease-out
        focus:outline-none focus:ring-2 focus:ring-inset focus:border-transparent
        ${hasError ? 'border-[var(--color-error-500)] focus:ring-[var(--color-error-500)]' : 'border-[var(--border-primary)] focus:ring-[var(--border-focus)]'}
      `}
      required={required}
      value={value}
      autocomplete={autocomplete}
      aria-invalid={hasError}
      aria-describedby={error ? `${id}-error` : hint ? `${id}-hint` : undefined}
    >
      {!required && <option value="">Select…</option>}
      {options?.map(opt => (
        <option value={opt.value} selected={value === opt.value}>
          {opt.label}
        </option>
      ))}
    </select>
  ) : (
    <input
      type={type}
      id={id}
      name={name}
      class={`
        w-full font-body text-sm bg-[var(--bg-input)] border rounded-lg px-4 py-3
        text-[var(--text-primary)] placeholder:text-[var(--text-muted)]
        transition-all duration-200 ease-out
        focus:outline-none focus:ring-2 focus:ring-inset focus:border-transparent
        ${hasError ? 'border-[var(--color-error-500)] focus:ring-[var(--color-error-500)]' : 'border-[var(--border-primary)] focus:ring-[var(--border-focus)]'}
      `}
      placeholder={placeholder}
      required={required}
      value={value}
      autocomplete={autocomplete}
      pattern={pattern}
      maxlength={maxlength}
      min={min}
      max={max}
      step={step}
      aria-invalid={hasError}
      aria-describedby={error ? `${id}-error` : hint ? `${id}-hint` : undefined}
    />
  )}
  {hint && !error && (
    <p id={`${id}-hint`} class="font-body text-xs text-[var(--text-muted)] mt-1">{hint}</p>
  )}
  {error && (
    <p id={`${id}-error`} class="font-body text-xs text-[var(--color-error-500)] mt-1" role="alert">{error}</p>
  )}
</div>