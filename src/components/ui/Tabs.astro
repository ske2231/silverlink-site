---
// Tabs.astro - Accessible tab component
interface Props {
  tabs: Array<{
    id: string;
    label: string;
    panel: any;
  }>;
  defaultTab?: string;
  class?: string;
}

const { tabs, defaultTab, class: className = '' } = Astro.props;
const defaultId = defaultTab || tabs[0]?.id;
---

<div class={className}>
  <div class="tabs flex gap-2 md:gap-4 mb-8 border-b border-border-primary" role="tablist">
    {tabs.map(tab => (
      <button
        role="tab"
        aria-selected={tab.id === defaultId}
        aria-controls={`${tab.id}-panel`}
        id={`${tab.id}-tab`}
        data-tab={tab.id}
        class="tab font-body font-medium text-body-sm px-4 py-3 text-text-muted hover:text-text-primary border-b-2 border-transparent transition-all duration-fast ease-smooth focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset"
      >
        {tab.label}
      </button>
    ))}
  </div>

  <div class="tab-panels">
    {tabs.map(tab => (
      <div
        role="tabpanel"
        id={`${tab.id}-panel`}
        aria-labelledby={`${tab.id}-tab`}
        class="tab-panel"
        hidden={tab.id !== defaultId}
      >
        {tab.panel}
      </div>
    ))}
  </div>
</div>

<script>
  document.querySelectorAll('.tabs').forEach(tablist => {
    const tabs = tablist.querySelectorAll('[role="tab"]');
    const panels = tablist.parentElement?.querySelectorAll('[role="tabpanel"]');

    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const tabId = tab.dataset.tab;
        
        // Update tabs
        tabs.forEach(t => {
          t.setAttribute('aria-selected', t.dataset.tab === tabId);
        });
        
        // Update panels
        panels?.forEach(panel => {
          panel.hidden = panel.id !== `${tabId}-panel`;
        });
      });

      // Keyboard navigation
      tab.addEventListener('keydown', (e) => {
        const index = Array.from(tabs).indexOf(tab);
        let newIndex = index;
        
        if (e.key === 'ArrowRight') newIndex = (index + 1) % tabs.length;
        if (e.key === 'ArrowLeft') newIndex = (index - 1 + tabs.length) % tabs.length;
        if (e.key === 'Home') newIndex = 0;
        if (e.key === 'End') newIndex = tabs.length - 1;
        
        if (newIndex !== index) {
          e.preventDefault();
          tabs[newIndex].click();
          tabs[newIndex].focus();
        }
      });
    });
  });
</script>