---
// Modal.astro - Accessible modal dialog
interface Props {
  id: string;
  title: string;
  subtitle?: string;
  open?: boolean;
  class?: string;
  closeLabel?: string;
}

const { id, title, subtitle, open = false, class: className = '', closeLabel = 'Close' } = Astro.props;
---

<div
  id={id}
  class={`modal-overlay fixed inset-0 bg-black/60 backdrop-blur-sm flex items-center justify-center p-4 z-modal ${open ? 'opacity-100 visible' : 'opacity-0 invisible pointer-events-none'} transition-all duration-normal ease-smooth`}
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${id}-title`}
  aria-hidden={!open}
>
  <div class={`modal-container bg-background-card border border-border-primary rounded-card max-w-4xl w-full max-h-[90vh] overflow-y-auto transform ${open ? 'scale-100' : 'scale-95'} transition-transform duration-normal ease-smooth`}>
    <button
      class="modal-close absolute top-4 right-4 w-10 h-10 rounded-full bg-background-tertiary text-text-secondary flex items-center justify-center text-2xl hover:bg-background-hover hover:text-text-primary transition-all duration-fast focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-border-focus"
      aria-label={closeLabel}
      data-modal-close
    >
      <svg class="icon icon-md" aria-hidden="true"><use href="/icons.svg#icon-x" /></svg>
    </button>

    <div class="modal-header px-6 py-6 border-b border-border-secondary">
      <h2 id={`${id}-title`} class="font-display text-heading-xl text-text-primary">{title}</h2>
      {subtitle && <p class="font-body text-body-sm text-text-muted mt-1">{subtitle}</p>}
    </div>

    <div class="modal-body p-6">
      <slot />
    </div>
  </div>
</div>

<script is:inline>
  // Modal functionality - client only
  const overlay = document.currentScript?.parentElement?.querySelector('.modal-overlay');
  if (!overlay) return;

  const closeBtn = overlay.querySelector('[data-modal-close]');
  let lastFocusedElement = null;

  function openModal() {
    lastFocusedElement = document.activeElement as HTMLElement;
    overlay.classList.remove('opacity-0', 'invisible', 'pointer-events-none');
    overlay.classList.add('opacity-100', 'visible');
    document.body.style.overflow = 'hidden';
    // Focus first focusable element in modal
    const focusable = overlay.querySelector('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])') as HTMLElement;
    focusable?.focus();
  }

  function closeModal() {
    overlay.classList.add('opacity-0', 'invisible', 'pointer-events-none');
    overlay.classList.remove('opacity-100', 'visible');
    document.body.style.overflow = '';
    lastFocusedElement?.focus();
  }

  // Close on backdrop click
  overlay.addEventListener('click', (e) => {
    if (e.target === overlay) closeModal();
  });

  // Close on close button
  closeBtn?.addEventListener('click', closeModal);

  // Close on Escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('visible')) {
      closeModal();
    }
  });

  // Focus trap
  overlay.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab' || !overlay.classList.contains('visible')) return;

    const focusableElements = overlay.querySelectorAll('button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])');
    const firstElement = focusableElements[0] as HTMLElement;
    const lastElement = focusableElements[focusableElements.length - 1] as HTMLElement;

    if (e.shiftKey && document.activeElement === firstElement) {
      e.preventDefault();
      lastElement.focus();
    } else if (!e.shiftKey && document.activeElement === lastElement) {
      e.preventDefault();
      firstElement.focus();
    }
  });

  // Expose open/close globally for other components
  (window as any).modals = (window as any).modals || {};
  (window as any).modals[id] = { open: openModal, close: closeModal };
</script>