---
// Accordion.astro - FAQ accordion component
interface Props {
  items: Array<{
    question: string;
    answer: string;
    open?: boolean;
  }>;
  class?: string;
}

const { items, class: className = '' } = Astro.props;
---

<div class={`space-y-3 ${className}`}>
  {items.map((item, index) => (
    <details class={`accordion card overflow-hidden ${item.open ? 'open' : ''}`} open={item.open}>
      <summary class="accordion-trigger w-full flex items-center justify-between gap-4 p-5 font-body font-medium text-[var(--text-primary)] bg-transparent border-none text-left cursor-pointer list-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--border-focus)]">
        <span class="accordion-title text-sm md:text-base">{item.question}</span>
        <svg class="accordion-icon flex-shrink-0 w-5 h-5 text-[var(--text-muted)] transition-transform duration-200" aria-hidden="true"><use href="/icons.svg#icon-chevron-down" /></svg>
      </summary>
      <div class="accordion-content overflow-hidden">
        <div class="accordion-body px-5 pb-5 font-body text-sm md:text-base text-[var(--text-secondary)] leading-relaxed">
          {item.answer}
        </div>
      </div>
    </details>
  ))}
</div>

<style>
  .accordion-trigger::-webkit-details-marker { display: none; }
  .accordion-trigger::marker { display: none; }

  .accordion-trigger {
    list-style: none;
    transition: background-color 0.2s ease;
  }

  .accordion-trigger:hover {
    background-color: var(--bg-hover);
  }

  .accordion[open] .accordion-icon {
    transform: rotate(180deg);
  }

  .accordion-content {
    transition: max-height 0.3s ease-out, padding 0.2s ease;
  }

  .accordion-content > div {
    padding-top: 0;
    transition: padding 0.2s ease;
  }
</style>

<script>
  // Smooth height animation for accordion
  document.querySelectorAll('.accordion').forEach(accordion => {
    const content = accordion.querySelector('.accordion-content') as HTMLElement;
    const body = accordion.querySelector('.accordion-body') as HTMLElement;

    function updateHeight() {
      if (accordion.open) {
        content.style.maxHeight = body.scrollHeight + 'px';
      } else {
        content.style.maxHeight = '0px';
      }
    }

    // Initial setup
    content.style.maxHeight = accordion.open ? body.scrollHeight + 'px' : '0px';
    content.style.transition = 'max-height 0.3s ease-out';

    // Watch for open/close
    const observer = new MutationObserver(updateHeight);
    observer.observe(accordion, { attributes: true, attributeFilter: ['open'] });
  });
</script>