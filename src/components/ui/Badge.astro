---
// Badge.astro - Tag/badge component
interface Props {
  children: any;
  variant?: 'blue' | 'silver' | 'success' | 'warning' | 'error';
  class?: string;
}

const { children, variant = 'blue', class: className = '' } = Astro.props;

const variantClasses = {
  blue: 'bg-[var(--accent-subtle)] text-[var(--accent-primary)]',
  silver: 'bg-[var(--color-silver-200)] text-[var(--color-charcoal-700)]',
  success: 'bg-[var(--color-success-100)] text-[var(--color-success-600)]',
  warning: 'bg-[var(--color-warning-100)] text-[var(--color-warning-600)]',
  error: 'bg-[var(--color-error-100)] text-[var(--color-error-600)]'
};
---

<span class={`inline-flex items-center font-body font-medium text-xs px-3 py-1 rounded-full uppercase tracking-wider ${variantClasses[variant]} ${className}`}>
  {children}
</span>