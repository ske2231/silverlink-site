---
// Card.astro - Base card component
interface Props {
  children: any;
  class?: string;
  hover?: boolean;
  bordered?: boolean;
}

const { children, class: className = '', hover = true, bordered = true } = Astro.props;
---

<article class={`
  bg-background-card
  ${bordered ? 'border border-border-primary' : ''}
  rounded-card p-6 md:p-8
  ${hover ? 'transition-all duration-normal ease-smooth hover:border-gold-500/50 hover:shadow-lg' : ''}
  flex flex-col h-full
  ${className}
`}>
  {children}
</article>