---
// PlanCard.astro - Pricing plan card
import Button from './Button.astro';
interface Props {
  name: string;
  price: number;
  period?: string;
  popular?: boolean;
  perk?: string;
  features: string[];
  ctaText: string;
  ctaHref?: string;
  ctaVariant?: 'primary' | 'secondary';
  class?: string;
}

const {
  name,
  price,
  period = '/month',
  popular = false,
  perk,
  features,
  ctaText,
  ctaHref,
  ctaVariant = 'primary',
  class: className = ''
} = Astro.props;
---

<div class={`
  relative
  bg-background-card
  border-2 ${popular ? 'border-gold-500' : 'border-border-primary'}
  rounded-card p-6 md:p-8
  flex flex-col h-full
  ${popular ? 'shadow-lg' : 'transition-all duration-normal ease-smooth hover:border-gold-500/50 hover:shadow-lg'}
  ${className}
`}>
  {popular && (
    <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-gold-500 text-navy-900 text-caption font-semibold px-3 py-1 rounded-badge">
      Most Popular
    </span>
  )}

  <h3 class="font-display text-heading-xl text-text-primary text-center mb-2">{name}</h3>

  <div class="flex items-baseline justify-center gap-1 mb-2">
    <span class="font-display text-heading-lg text-gold-500">$</span>
    <span class="font-display text-display-sm text-text-primary">{price}</span>
    <span class="font-body text-body text-text-muted">{period}</span>
  </div>

  {perk && (
    <p class="text-center text-body-sm text-gold-600 dark:text-gold-400 mb-6 p-3 bg-gold-100/50 dark:bg-gold-900/20 rounded-md">
      {perk}
    </p>
  )}

  <ul class="flex-1 space-y-3 mb-6">
    {features.map(feature => (
      <li class="flex items-start gap-3 text-body text-text-secondary">
        <span class="flex-shrink-0 w-5 h-5 rounded-full bg-gold-100/50 dark:bg-gold-900/20 flex items-center justify-center text-gold-600 dark:text-gold-400 font-bold text-caption">
          <svg class="icon icon-xs" aria-hidden="true"><use href="/icons.svg#icon-check" /></svg>
        </span>
        <span>{feature}</span>
      </li>
    ))}
  </ul>

  <Button
    variant={ctaVariant}
    size="lg"
    fullWidth
    href={ctaHref}
    class="mt-auto"
  >
    {ctaText}
  </Button>
</div>