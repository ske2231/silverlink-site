---
// SectionLabel.astro - Section label component
interface Props {
  children: any;
  ruled?: boolean;
  class?: string;
}

const { children, ruled = false, class: className = '' } = Astro.props;
---

<span class={`section-label ${className}`}>
  {children}
  {ruled && <span class="section-label-rule"></span>}
</span>

<style>
  .section-label {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-primary);
    margin-bottom: 0.75rem;
    position: relative;
  }

  .section-label-rule {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 1.75rem;
    height: 2.5px;
    background: var(--accent-primary);
    border-radius: 1px;
  }
</style>