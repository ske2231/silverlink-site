---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "SilverLink — Video Walkthroughs & Friendly IT Support | Oklahoma City";
const description = "SilverLink turns listing photos into room-to-room video walkthroughs for Oklahoma realtors — and gives patient, plain-English tech help to homes, seniors, and small businesses in the OKC metro.";
---

<BaseLayout title={title} description={description} active="home">
  <!-- HERO -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <span class="eyebrow">SilverLink LLC · Oklahoma City, OK</span>
        <h1>One friendly local expert — <span class="warm">for your listings and your laptop.</span></h1>
        <p class="lede">
          SilverLink does two things with the same care: we turn your listing photos
          into smooth, room-to-room video tours for Oklahoma realtors — and we fix
          tech headaches for homes, seniors, and small businesses, patiently and in
          plain English. No jargon, no runaround, no call centers.
        </p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/walkthroughs/">Get a Walkthrough Video</a>
          <a class="btn btn-ghost" href="/it-support/">Get Tech Help</a>
        </div>
        <p class="hero-note">
          <strong>Realtor?</strong> Send photos, get a video back in 48 hours.<br />
          <strong>Tech trouble?</strong> Call or text <a href="tel:+14058772223">(405) 877-2223</a> — a real person (MK) answers.
        </p>
      </div>
      <div>
        <div class="hero-media">
          <video controls preload="metadata" poster="/tour-poster.jpg" aria-label="Sample virtual walkthrough video">
            <source src="/sample-tour.mp4" type="video/mp4" />
            Your browser does not support the video tag.
          </video>
          <div class="media-caption">
            <span><strong>Sample tour</strong> — built from ordinary listing photos</span>
            <span>0:57</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST -->
  <div class="trust" role="list" aria-label="Why SilverLink">
    <div class="wrap">
      <div class="trust-item" role="listitem"><div class="t">48 hours</div><div class="s">Walkthrough turnaround</div></div>
      <div class="trust-item" role="listitem"><div class="t">Same friendly knowledgeable specialist</div><div class="s">Every call, every visit</div></div>
      <div class="trust-item" role="listitem"><div class="t">No jargon</div><div class="s">Plain-English tech help</div></div>
      <div class="trust-item" role="listitem"><div class="t">Local</div><div class="s">Oklahoma owned &amp; operated</div></div>
    </div>
  </div>

  <!-- TWO SERVICES -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Two services, one standard</span>
        <h2>Helpful, honest, and close to home</h2>
        <p>Whether you're selling a house or just trying to get your printer working, you get the same promise: done right, explained kindly.</p>
      </div>
      <div class="cards">
        <div class="card accent-card">
          <span class="icon" aria-hidden="true">🏠</span>
          <h3>Video Walkthroughs for Realtors</h3>
          <p>
            You already took the photos — we do everything else. Smooth forward-motion
            video, room labels, your branding on the title card, and a shareable link
            that plays beautifully on any phone. From <strong>$149</strong> per listing.
          </p>
          <ul class="checklist">
            <li>True walking motion — never a slideshow</li>
            <li>Branded + MLS-ready unbranded versions</li>
            <li>48-hour standard turnaround</li>
          </ul>
          <div class="card-actions">
            <a class="btn btn-primary" href="/walkthroughs/">See How It Works</a>
            <a class="btn btn-ghost" href="/book/">Book a Tour</a>
          </div>
        </div>
        <div class="card accent-card">
          <span class="icon" aria-hidden="true">💛</span>
          <h3>Patient IT Support for Everyone Else</h3>
          <p>
            Phones, Wi-Fi, email, printers, scams, setups — the tech headaches that
            eat your afternoon, fixed by someone who explains it like a neighbor
            would. Remote or on-site, from <strong>$79</strong>.
          </p>
          <ul class="checklist">
            <li>Seniors are our specialty — never rushed</li>
            <li>Remote screen-share or we come to you</li>
            <li>Month-to-month care plans available</li>
          </ul>
          <div class="card-actions">
            <a class="btn btn-primary" href="/it-support/">Get Tech Help</a>
            <a class="btn btn-ghost" href="/book/">Book a Visit</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section alt">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">For realtors</span>
        <h2>From photos to walkthrough in three steps</h2>
        <p>No filming appointments. No special equipment. You already did the hard part.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="num" aria-hidden="true">1</div>
          <h3>Send your listing photos</h3>
          <p>Phone snapshots or professional shots — plus the address and specs. Takes about five minutes.</p>
        </div>
        <div class="step">
          <div class="num" aria-hidden="true">2</div>
          <h3>We build your walking tour</h3>
          <p>Smooth forward-motion video stitched room to room, with room labels, a branded title card, and your contact info on the closing card.</p>
        </div>
        <div class="step">
          <div class="num" aria-hidden="true">3</div>
          <h3>Share it everywhere</h3>
          <p>Post it on the MLS, Zillow, Facebook, Instagram, and email. One link that plays beautifully on any phone.</p>
        </div>
      </div>
      <div class="photo-strip" aria-label="Example listing photos">
        <figure><img src="/images/photo-01.webp" alt="Listing photo: home exterior" loading="lazy" /><figcaption>Your photos…</figcaption></figure>
        <figure><img src="/images/photo-03.webp" alt="Listing photo: living room" loading="lazy" /><figcaption>…become rooms…</figcaption></figure>
        <figure><img src="/images/photo-05.webp" alt="Listing photo: kitchen" loading="lazy" /><figcaption>…in a walking tour.</figcaption></figure>
      </div>
      <p class="transform-note">
        The photos above became the <strong>57-second walking tour</strong> at the top of this page.
        Same photos, same home — just moving.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Good questions</h2>
      </div>
      <div class="faq">
        <details>
          <summary>I'm not very tech-savvy. Is this for me?</summary>
          <p>Especially for you. A lot of our home clients are seniors, and everything is explained in plain English — no jargon, no rushing, no making you feel silly for asking. If you can describe what's wrong, we can fix it.</p>
        </details>
        <details>
          <summary>Do I have to bring my computer somewhere?</summary>
          <p>No. Most issues are handled over a secure screen-share while you watch, or we come to you anywhere in the OKC metro. You never haul equipment to a shop or wait in line.</p>
        </details>
        <details>
          <summary>Is the walkthrough a slideshow with zoom effects?</summary>
          <p>No. Each photo is animated with smooth forward camera motion and stitched in walking order, room to room — so it feels like actually walking through the home.</p>
        </details>
        <details>
          <summary>How fast will I get my walkthrough video?</summary>
          <p>Standard turnaround is 48 hours from the time we receive your photos. Listing Partner plans include 24-hour turnaround, and a 24-hour rush is available on any tour for $49.</p>
        </details>
        <details>
          <summary>Who owns the finished video?</summary>
          <p>You do. Every tour comes with full usage rights and a downloadable file, plus a shareable link you can post anywhere.</p>
        </details>
        <details>
          <summary>What areas do you serve?</summary>
          <p>Walkthrough videos are built remotely from your photos, so we serve all of Oklahoma. On-site IT visits cover the Oklahoma City metro, and remote support works anywhere.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" style="padding-top: 1rem;">
    <div class="wrap">
      <div class="cta-band">
        <h2>Let's make your day a little easier</h2>
        <p>A listing that needs a tour, a laptop that needs a friend — tell us what's going on.</p>
        <div class="cta-actions">
          <a class="btn btn-primary btn-large" href="/book/">Request Service</a>
          <a class="btn btn-ghost" href="tel:+14058772223">Call (405) 877-2223</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
