---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "SilverLink — IT Support for Businesses, Families & Seniors | Oklahoma City";
const description = "Friendly, plain-English IT support in the OKC metro. Managed IT for small businesses from $99/user/mo, care plans for families and seniors from $49/mo, one-time fixes from $79. Remote or on-site. Call (405) 877-2223.";
---

<BaseLayout title={title} description={description} active="home">
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "SilverLink LLC",
    "description": "IT support and managed services for small businesses, families, and seniors in the Oklahoma City metro.",
    "telephone": "+1-405-877-2223",
    "email": "mk@silverlinkok.com",
    "url": "https://www.silverlinkok.com/",
    "areaServed": "Oklahoma City metro",
    "address": { "@type": "PostalAddress", "addressLocality": "Oklahoma City", "addressRegion": "OK", "addressCountry": "US" },
    "openingHours": ["Mo-Fr 09:00-18:00", "Sa 10:00-14:00"],
    "aggregateRating": { "@type": "AggregateRating", "ratingValue": "5.0", "reviewCount": "11" }
  })} />

  <!-- PHOTO HERO -->
  <section class="photo-hero">
    <div class="ph-bg" aria-hidden="true">
      <img src="/images/it-hero.webp" alt="" fetchpriority="high" />
    </div>
    <div class="ph-shade" aria-hidden="true"></div>
    <div class="wrap">
      <span class="eyebrow">SilverLink LLC · IT support · Oklahoma City metro</span>
      <h1>Tech headaches, <span class="warm">handled.</span></h1>
      <p class="lede">
        Friendly IT support for small businesses, families, and seniors in the OKC metro.
        Remote or on-site, explained in plain English, by the same local expert every
        single time. No jargon, no call centers, no runaround.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-large" href="tel:+14058772223">Call or Text (405) 877-2223</a>
        <a class="btn btn-light" href="#pricing">See Pricing</a>
      </div>
      <p class="hero-note">
        <strong>Something broken right now?</strong> Call — same-day remote help is usually
        available. <strong>CompTIA A+ &amp; Security+ certified</strong> · Google rated 5.0 ★ · 18 years in IT.
      </p>
    </div>
  </section>

  <!-- TRUST BAND -->
  <div class="trust" role="list" aria-label="Why SilverLink">
    <div class="wrap">
      <div class="trust-item" role="listitem"><div class="t">18 years</div><div class="s">Professional IT experience</div></div>
      <div class="trust-item" role="listitem"><div class="t">A+ &amp; Security+</div><div class="s">CompTIA certified</div></div>
      <div class="trust-item" role="listitem"><div class="t">5.0 ★</div><div class="s">Google rated</div></div>
      <div class="trust-item" role="listitem"><div class="t">Local</div><div class="s">Oklahoma owned &amp; operated</div></div>
    </div>
  </div>

  <!-- WHO WE HELP -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Who we help</span>
        <h2>One expert, three kinds of people</h2>
        <p>Same promise for everyone: done right, explained kindly, priced honestly.</p>
      </div>
      <div class="steps">
        <div class="step">
          <span class="icon" aria-hidden="true" style="font-size: 1.8rem;">🏪</span>
          <h3 style="margin-top: 0.6rem;">Small Businesses</h3>
          <p><strong>Your entire IT department for $99 per user, per month.</strong> Desktops, Wi-Fi, email, security — handled, so you never lose a workday to tech again.</p>
          <p>Microsoft 365 &amp; Google Workspace · network &amp; Wi-Fi · employee onboarding &amp; offboarding · security &amp; scam protection · vendor wrangling.</p>
        </div>
        <div class="step">
          <span class="icon" aria-hidden="true" style="font-size: 1.8rem;">🏡</span>
          <h3 style="margin-top: 0.6rem;">Families</h3>
          <p>Wi-Fi that reaches every room, new devices set up right, backups that actually run, and the nagging problems finally fixed.</p>
          <p>New computer &amp; phone setup with data transfer · virus &amp; malware removal · smart home &amp; cameras · parental controls · monthly care plans from $49.</p>
        </div>
        <div class="step">
          <span class="icon" aria-hidden="true" style="font-size: 1.8rem;">👵</span>
          <h3 style="margin-top: 0.6rem;">Seniors</h3>
          <p><strong>Our specialty.</strong> Unhurried help in plain English — no question too small, never rushed, never made to feel silly.</p>
          <p>Phones, tablets &amp; email · video calls with grandkids · scam &amp; fraud protection · printers · a monthly in-home visit option.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section class="section alt" id="pricing">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Honest pricing</span>
        <h2>Plans that pay for themselves</h2>
        <p>Month-to-month on everything — cancel anytime. Flat rates quoted up front.</p>
      </div>

      <!-- BUSINESS -->
      <div class="plans plans-2">
        <div class="plan featured">
          <span class="badge">Best value for offices</span>
          <h3>Business Care</h3>
          <p class="price">$99<span style="font-size: 1.1rem; font-weight: 600;"> /user</span></p>
          <p class="per">per user, per month · 2+ users</p>
          <ul>
            <li>Unlimited remote support during business hours</li>
            <li>Same-day response for members</li>
            <li>Microsoft 365 / Google Workspace admin</li>
            <li>Patching, antivirus &amp; backup monitoring on every device</li>
            <li>Network, Wi-Fi &amp; printer management</li>
            <li>Employee onboarding &amp; offboarding</li>
            <li>Quarterly check-in &amp; security review</li>
            <li>We deal with your vendors so you don't</li>
          </ul>
          <a class="btn btn-primary" href="/book/">Get a Free IT Checkup</a>
        </div>
        <div class="plan">
          <h3>Not ready for monthly?</h3>
          <p class="price" style="font-size: 1.6rem;">Business help à la carte</p>
          <p class="per">One-time visits, flat rate</p>
          <ul>
            <li>On-site fix or setup — $149 flat, up to 90 minutes</li>
            <li>Remote Quick Fix — $79, up to 45 minutes</li>
            <li>Office Wi-Fi &amp; network tune-up — $129</li>
            <li>Security &amp; scam hardening — $249</li>
            <li>Free 15-minute phone assessment first</li>
          </ul>
          <a class="btn btn-ghost" href="/book/">Book a Visit</a>
        </div>
      </div>

      <!-- HOME PLANS -->
      <div class="section-head" style="margin-top: 4rem;">
        <span class="eyebrow">For home, family &amp; seniors</span>
        <h2>Monthly care plans</h2>
        <p>Like having a tech-savvy grandkid on call — without waiting for the holidays.</p>
      </div>
      <div class="plans">
        <div class="plan">
          <h3>Essentials</h3>
          <p class="price">$49</p>
          <p class="per">per month · 1 computer</p>
          <ul>
            <li>Remote help during business hours</li>
            <li>Updates &amp; tune-ups handled for you</li>
            <li>Antivirus &amp; backup monitoring</li>
            <li>Discounted on-site visits ($99)</li>
          </ul>
          <a class="btn btn-ghost" href="/book/">Start Essentials</a>
        </div>
        <div class="plan featured">
          <span class="badge">Most popular</span>
          <h3>Family Care</h3>
          <p class="price">$59</p>
          <p class="per">per month · up to 4 devices</p>
          <ul>
            <li>Everything in Essentials</li>
            <li>Covers computers, phones &amp; tablets</li>
            <li>Remote help for the whole family</li>
            <li>Discounted on-site visits ($99)</li>
            <li>Backup checks on the family photos</li>
          </ul>
          <a class="btn btn-primary" href="/book/">Start Family Care</a>
        </div>
        <div class="plan">
          <h3>Senior Peace of Mind</h3>
          <p class="price">$179</p>
          <p class="per">per month · whole household</p>
          <ul>
            <li>Unlimited devices, unlimited remote help</li>
            <li>A friendly in-home visit every month</li>
            <li>Scam &amp; fraud protection set up and watched</li>
            <li>Family members can call on your behalf</li>
            <li>Priority response — never a long wait</li>
          </ul>
          <a class="btn btn-ghost" href="/book/">Start Peace of Mind</a>
        </div>
      </div>

      <!-- ONE-TIME -->
      <div class="section-head" style="margin-top: 4rem;">
        <span class="eyebrow">No commitment</span>
        <h2>One-time help</h2>
        <p>Flat rates, quoted up front. If we can't fix it, we'll tell you straight — we don't bill you for shrugging.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="num" aria-hidden="true">$</div>
          <h3>Quick Fix — $79</h3>
          <p>One remote troubleshooting session, up to 45 minutes. Secure screen-share you watch the whole time. No travel fee.</p>
        </div>
        <div class="step">
          <div class="num" aria-hidden="true">$</div>
          <h3>Setup &amp; Optimize — $149</h3>
          <p>New computer or phone set up right: data transferred, accounts signed in, security baseline applied. Up to 90 minutes.</p>
        </div>
        <div class="step">
          <div class="num" aria-hidden="true">$</div>
          <h3>Network Tune-Up — $129</h3>
          <p>Wi-Fi that actually reaches the back bedroom. Router placement, optimization, whole-home coverage check.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- EMERGENCY BAND -->
  <section class="feature-band">
    <div class="wrap" style="display: flex; flex-wrap: wrap; gap: 2rem; align-items: center; justify-content: space-between;">
      <div>
        <h2 style="margin: 0 0 0.4rem;">Something broken right now?</h2>
        <p style="margin: 0; color: #ffe9d4;">Call or text — if it can be fixed remotely, we can usually fix it today.</p>
      </div>
      <a class="btn btn-light btn-large" href="tel:+14058772223">Call (405) 877-2223</a>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2>Getting help is easy</h2>
      </div>
      <div class="steps">
        <div class="step">
          <div class="num" aria-hidden="true">1</div>
          <h3>Reach out</h3>
          <p>Call, text, or send the request form. A real person — MK — responds the same day, usually within hours.</p>
        </div>
        <div class="step">
          <div class="num" aria-hidden="true">2</div>
          <h3>We fix it</h3>
          <p>Remote screen-share or on-site visit, whatever the problem needs. You watch everything we do.</p>
        </div>
        <div class="step">
          <div class="num" aria-hidden="true">3</div>
          <h3>It stays fixed</h3>
          <p>You get a plain-English summary of what happened and how to avoid it next time. 30-day warranty on the work.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section alt">
    <div class="wrap">
      <div class="section-head">
        <h2>Questions, answered</h2>
      </div>
      <div class="faq">
        <details>
          <summary>I'm not very tech-savvy. Is this for me?</summary>
          <p>Especially for you. Many of our clients are seniors, and everything is explained in plain English — no jargon, no rushing, no making you feel silly for asking. If you can describe what's wrong, we can fix it.</p>
        </details>
        <details>
          <summary>Do I have to bring my computer somewhere?</summary>
          <p>No. Most issues are handled over a secure screen-share while you watch, or we come to you anywhere in the OKC metro. You never haul equipment to a shop or wait in line.</p>
        </details>
        <details>
          <summary>What does "per user" pricing mean for businesses?</summary>
          <p>Simple: $99 a month per person on your team. Everyone gets support, every device they use gets managed — no surprise invoices, no counting machines. Most OKC IT firms charge $149 or more per user and make you call a help desk. With us, you get MK on every call.</p>
        </details>
        <details>
          <summary>Is remote help safe?</summary>
          <p>Yes. You see everything we do on your screen, you stay in control, and you can end the session anytime. We only connect with your permission, and only for the issue you asked about.</p>
        </details>
        <details>
          <summary>What are your hours?</summary>
          <p>Mon–Fri 9 AM–6 PM, Sat 10 AM–2 PM. Care-plan members get priority scheduling.</p>
        </details>
        <details>
          <summary>What areas do you serve?</summary>
          <p>On-site visits cover the Oklahoma City metro. Remote support works anywhere.</p>
        </details>
      </div>
    </div>
  </section>

  <!-- REALTOR CROSS-SELL -->
  <section class="section" style="padding-top: 1rem;">
    <div class="wrap">
      <div class="card" style="text-align: center;">
        <p style="margin: 0 0 0.6rem; color: var(--muted);">Realtor? 🏠</p>
        <h3 style="margin-top: 0;">We also turn your listing photos into video walkthroughs.</h3>
        <p style="margin-bottom: 1.2rem;">Send photos, get a smooth room-to-room video back in 48 hours — from $149 per listing.</p>
        <a class="btn btn-ghost" href="/walkthroughs/">See Walkthrough Videos</a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section" style="padding-top: 1rem;">
    <div class="wrap">
      <div class="cta-photo">
        <div class="ph-bg" aria-hidden="true">
          <img src="/images/it-business.webp" alt="MK helping an Oklahoma small business owner with her computer" loading="lazy" />
        </div>
        <div class="ph-shade" aria-hidden="true"></div>
        <div class="cta-inner">
          <h2>Let's get it fixed today.</h2>
          <p>Call, text, or send a request — a real person will get back to you.</p>
          <div class="cta-actions">
            <a class="btn btn-primary btn-large" href="tel:+14058772223">Call (405) 877-2223</a>
            <a class="btn btn-light" href="/book/">Request Help Online</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
