---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Thanks — We'll Be in Touch | SilverLink";
const description = "Your request was sent to SilverLink. A real person (MK) will get back to you, usually the same day during business hours.";
---

<BaseLayout title={title} description={description} noindex={true}>
  <section class="section">
    <div class="wrap" style="text-align: center; max-width: 640px;">
      <span class="eyebrow">Request received</span>
      <h1>Thanks — <span class="warm">we've got it.</span></h1>
      <p class="lede">
        Your request was sent. A real person — MK — will get back to you,
        usually the same day during business hours (Mon–Fri 9 AM–6 PM, Sat 10 AM–2 PM).
      </p>
      <p>
        Something urgent? Call or text
        <a href="tel:+14058772223">(405) 877-2223</a> — same-day remote help is
        usually available.
      </p>
      <div class="hero-actions" style="justify-content: center;">
        <a class="btn btn-primary" href="/">Back to Home</a>
        <a class="btn btn-light" href="/walkthroughs/">See Walkthroughs</a>
      </div>
    </div>
  </section>
</BaseLayout>
