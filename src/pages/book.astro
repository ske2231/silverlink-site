---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "Book a Walkthrough or Get Tech Help | SilverLink";
const description = "Request a video walkthrough or friendly tech help from SilverLink. Call or text (405) 877-2223, email mk@silverlinkok.com, or send a request online.";
---

<BaseLayout title={title} description={description} active="book">
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Get started</span>
        <h2>Book a walkthrough or get tech help</h2>
        <p>Tell us what you need — a human (MK) will get back to you.</p>
      </div>
      <div class="contact-grid">
        <div class="contact-info">
          <h3>Talk to a human</h3>
          <div class="contact-line"><span class="label">Phone</span><a href="tel:+14058772223">(405) 877-2223</a></div>
          <div class="contact-line"><span class="label">Email</span><a href="mailto:mk@silverlinkok.com">mk@silverlinkok.com</a></div>
          <div class="contact-line"><span class="label">Hours</span><span>Mon–Fri 9 AM–6 PM<br />Sat 10 AM–2 PM</span></div>
          <div class="contact-line"><span class="label">Area</span><span>Oklahoma City metro (on-site)<br />All of Oklahoma (walkthroughs)<br />Anywhere (remote support)</span></div>
          <p style="color: var(--muted); font-size: 0.95rem;">
            Prefer to talk it through first? Call or text — we usually answer
            same-day during business hours.
          </p>
        </div>
        <form class="contact-form" id="booking-form" aria-label="Request service">
          <h3>Request service</h3>
          <p class="sub">Fill this out and it will open a pre-addressed email to us — nothing is stored on this site.</p>
          <div class="form-row">
            <div class="field">
              <label for="f-name">Your name</label>
              <input id="f-name" name="name" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="f-phone">Phone</label>
              <input id="f-phone" name="phone" type="tel" autocomplete="tel" required />
            </div>
          </div>
          <div class="field">
            <label for="f-email">Email</label>
            <input id="f-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="f-address">Property address <span class="opt">(walkthroughs only)</span></label>
            <input id="f-address" name="address" type="text" placeholder="e.g. 1234 Main St, Oklahoma City, OK" />
          </div>
          <div class="field">
            <label for="f-package">I'm interested in</label>
            <select id="f-package" name="package">
              <optgroup label="Video walkthroughs">
                <option value="Single Tour ($149)">Single Tour ($149)</option>
                <option value="3-Tour Pack ($399)">3-Tour Pack ($399)</option>
                <option value="Listing Partner ($499/mo)">Listing Partner ($499/mo)</option>
              </optgroup>
              <optgroup label="IT support — one-time">
                <option value="Quick Fix ($79)">Quick Fix — remote session ($79)</option>
                <option value="Setup & Optimize ($149)">Setup &amp; Optimize ($149)</option>
                <option value="Network Tune-Up ($129)">Network Tune-Up ($129)</option>
              </optgroup>
              <optgroup label="IT support — monthly">
                <option value="Essential Care ($199/mo)">Essential Care ($199/mo)</option>
                <option value="Business Care ($449/mo)">Business Care ($449/mo)</option>
              </optgroup>
              <option value="Not sure yet">Not sure yet — just have questions</option>
            </select>
          </div>
          <div class="field">
            <label for="f-msg">Anything we should know?</label>
            <textarea id="f-msg" name="message" placeholder="Describe the tech issue, or the listing timeline…"></textarea>
          </div>
          <button class="btn btn-primary" type="submit" style="width: 100%;">Send Request</button>
          <p class="form-note">Submitting opens your email app with the details filled in — just hit send.</p>
        </form>
      </div>
    </div>
  </section>

  <script>
    document.getElementById("booking-form")?.addEventListener("submit", function (e) {
      e.preventDefault();
      const data = new FormData(e.target as HTMLFormElement);
      const lines = [
        "New service request from silverlinkok.com",
        "",
        "Name: " + (data.get("name") || ""),
        "Phone: " + (data.get("phone") || ""),
        "Email: " + (data.get("email") || ""),
        "Property: " + (data.get("address") || ""),
        "Interested in: " + (data.get("package") || ""),
        "",
        "Details:",
        data.get("message") || "(none)",
      ];
      const subject = encodeURIComponent("Website request — " + (data.get("name") || "new lead"));
      const body = encodeURIComponent(lines.join("\n"));
      window.location.href = "mailto:mk@silverlinkok.com?subject=" + subject + "&body=" + body;
    });
  </script>
</BaseLayout>
