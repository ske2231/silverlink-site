---
import BaseLayout from "../layouts/BaseLayout.astro";

const title = "IT Support — SilverLink OKC";
const description = "Friendly IT support for businesses, families & seniors in Oklahoma City. Remote or on-site. Call (405) 877-2223.";
---

<BaseLayout title={title} description={description} active="it">
  <section class="photo-hero photo-hero--short">
    <div class="ph-bg" aria-hidden="true">
      <img src="/images/it-hero.webp" alt="" fetchpriority="high" />
    </div>
    <div class="ph-shade" aria-hidden="true"></div>
    <div class="wrap">
      <span class="eyebrow">One sec…</span>
      <h1>Our IT support page <span class="warm">has moved home.</span></h1>
      <p class="lede">
        Everything — pricing, plans, booking — now lives on our main page.
        Taking you there now, or
        <a href="/" style="color: #ffe9d4; text-decoration: underline;">tap here</a>.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-large" href="tel:+14058772223">Call (405) 877-2223</a>
        <a class="btn btn-light" href="/">Go to the Home Page</a>
      </div>
    </div>
  </section>

  <meta http-equiv="refresh" content="3; url=/" />
  <script is:inline>
    setTimeout(function () { window.location.replace("/"); }, 3000);
  </script>
</BaseLayout>
